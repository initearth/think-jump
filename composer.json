{
    "name": "initearth/think-jump",
    "description": "适用于 ThinkPHP 8.0 的跳转扩展",
    "keywords": ["thinkphp", "think-jump", "success","error","result","redirect"],
    "license": "MulanPSL-2.0",
    "type": "think-extend",
    "authors": [
        {
            "name": "initearth",
            "homepage": "https://github.com/initearth"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "topthink/framework": "^8.0",
        "topthink/think-view": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Initearth\\think\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Initearth\\think\\Tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "config": {
                "jump": "src/config/jump.php"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "composer validate --no-check-publish",
            "@test"
        ]
    }
}
